{
  "manifestVersion": 5,
  "id": "com.ntech.depthvibe.adobe.bridge",
  "name": "DepthVibe Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["http://127.0.0.1:47653", "https://127.0.0.1:47653"]
    }
  },
  "entrypoints": [
    {
      "id": "depthVibeBridgePanel",
      "type": "panel",
      "label": {"default": "DepthVibe Bridge"},
      "minimumSize": {"width": 300, "height": 260},
      "preferredDockedSize": {"width": 340, "height": 430},
      "preferredFloatingSize": {"width": 420, "height": 520}
    }
  ]
}